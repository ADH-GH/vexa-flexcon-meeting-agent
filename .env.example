# --- storage (compose sets DATABASE_URL from POSTGRES_PASSWORD) ---
POSTGRES_PASSWORD=change-me
# --- Vexa ---
VEXA_API_URL=http://vexa-gateway-001:8000
VEXA_API_KEY=
# --- diarizer service (github.com/ADH-GH/diarizer) ---
DIARIZER_URL=http://vexa-diarization-001:8008
# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=https://litellm.kraemer-ki.de/v1
LLM_API_KEY=
LLM_MODEL=DeepSeek-V4-Flash
# --- mail: smtp | graph ---
MAIL_TRANSPORT=smtp
MAIL_FROM=automation@flexcon-it.de
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# --- MS Graph (calendar for agent-dispatch; optional mail transport) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_CALENDAR_USER=automation@flexcon-it.de
# --- auth: Entra SSO + local user/password fallback ---
ENTRA_SSO_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
# Fernet key for user refresh tokens at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
# OAuth onboarding (Entra multi-tenant): the app registration's redirect URI + authority
OAUTH_AUTHORITY_TENANT=organizations
OAUTH_REDIRECT_URI=https://your-host/auth/callback
# --- billing (Stripe): the marketplace runs Checkout, this app reports metered usage ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_OVERAGE=
TRIAL_DAYS=14
# --- marketplace provisioning (shared secret for POST /billing/provision) ---
MARKETPLACE_SECRET=
